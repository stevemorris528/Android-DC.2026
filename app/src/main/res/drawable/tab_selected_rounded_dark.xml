<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="2dp"
        android:right="2dp"
        android:top="4dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="@dimen/tab_corner_radius"
                android:topRightRadius="@dimen/tab_corner_radius"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <solid android:color="?attr/appColorAccentPressed" />
            <stroke
                android:width="2dp"
                android:color="?attr/appColorAccent" />
        </shape>
    </item>
</layer-list>
