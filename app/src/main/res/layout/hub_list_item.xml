<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:descendantFocusability="blocksDescendants">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hub_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="127.0.0.1"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="?attr/appTextColorPrimary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hub_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connected"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="?attr/appTextColorSecondary" />

        <TextView
            android:id="@+id/hub_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Users: 0 | Tag: [AnDCpp V1]"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="?attr/appTextColorSecondary" />

    </LinearLayout>

    <!-- Right side: Auto-connect on top, Open underneath. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginLeft="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Connect this saved hub automatically when the app starts. Not focusable: the row stays tappable. -->
        <CheckBox
            android:id="@+id/hub_autoconnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:text="Auto-\nconnect"
            android:textSize="11sp"
            android:textColor="?attr/appTextColorSecondary" />

        <!-- Opens the hub's chat directly; shown while the hub is connected or connecting. -->
        <Button
            android:id="@+id/hub_open"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="4dp"
            android:minWidth="64dp"
            android:minHeight="0dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:background="@drawable/hub_open_button"
            android:stateListAnimator="@null"
            android:focusable="false"
            android:text="Open"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
