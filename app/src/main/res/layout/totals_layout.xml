<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appSurfaceColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Connection mode (auto-detected active / passive) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:background="?attr/appHeaderBackgroundColor"
            android:text="Connection"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="?attr/appTextColorSecondary" />

        <TextView
            android:id="@+id/totals_connection_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textStyle="bold"
            android:textColor="?attr/appTextColorPrimary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/appDividerColor" />

        <!-- All time -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:background="?attr/appHeaderBackgroundColor"
            android:text="All Time"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="?attr/appTextColorSecondary" />

        <TextView
            android:id="@+id/totals_alltime_dl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="12dp"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textStyle="bold"
            android:textColor="#00796B" />

        <TextView
            android:id="@+id/totals_alltime_ul"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="12dp"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textStyle="bold"
            android:textColor="#F9A825" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/appDividerColor" />

        <!-- This session -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:background="?attr/appHeaderBackgroundColor"
            android:text="This Session"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="?attr/appTextColorSecondary" />

        <TextView
            android:id="@+id/totals_session_dl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="12dp"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textStyle="bold"
            android:textColor="#00796B" />

        <TextView
            android:id="@+id/totals_session_ul"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="12dp"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textStyle="bold"
            android:textColor="#F9A825" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/appDividerColor" />

        <!-- Uploads -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:background="?attr/appHeaderBackgroundColor"
            android:text="Uploads / Downloads (This Session)"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="?attr/appTextColorSecondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:id="@+id/totals_upload_stats"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:lineSpacingExtra="4dp"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="?attr/appTextColorPrimary" />

            <TextView
                android:id="@+id/totals_download_stats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="8dp"
                android:paddingRight="16dp"
                android:lineSpacingExtra="4dp"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="?attr/appTextColorPrimary" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
