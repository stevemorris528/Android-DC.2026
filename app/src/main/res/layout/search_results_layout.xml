<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/appSurfaceColor">

    <!-- Header: same look as the Downloads header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="?attr/appHeaderBackgroundColor"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/txtSearchResultsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Search Results"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="?attr/appTextColorSecondary"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- Same style as "Clear Finished" on the Downloads tab -->
        <Button
            android:id="@+id/btnClearSearchResults"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/btn_indigo_outline_rounded"
            android:text="Clear"
            android:textColor="#3F51B5"
            android:textStyle="bold"
            android:textSize="12sp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:stateListAnimator="@null" />
    </LinearLayout>

    <ListView
        android:id="@+id/listView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="?attr/appDividerColor"
        android:dividerHeight="1dp" />
</LinearLayout>
