<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/appSurfaceColor">

    <!-- Auto-connect is chosen per saved hub (the checkbox on each row). -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="Tick Auto-connect on a saved hub to connect to it when the app starts."
        android:textColor="?attr/appTextColorSecondary"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/appDividerColor" />

    <ListView
        android:id="@+id/hub_list_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="?attr/appDividerColor"
        android:dividerHeight="1dp" />
</LinearLayout>
