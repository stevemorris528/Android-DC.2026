<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/appSurfaceColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="?attr/appHeaderBackgroundColor"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Downloads"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="?attr/appTextColorSecondary" />

        <Button
            android:id="@+id/btnClearFinished"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear Finished"
            android:textSize="12sp"
            android:visibility="visible" />

        <Button
            android:id="@+id/btnResetAllDownloads"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Reset All"
            android:textSize="12sp"
            android:visibility="visible" />
    </LinearLayout>

    <!-- Uploads: same look as the Downloads header and rows -->
    <LinearLayout
        android:id="@+id/uploadStatsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/appDividerColor" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:background="?attr/appHeaderBackgroundColor"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Uploads"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="?attr/appTextColorSecondary" />

            <TextView
                android:id="@+id/txtUploadSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="#00796B" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtUploadStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="?attr/appTextColorSecondary"
            android:singleLine="true"
            android:ellipsize="end" />

        <LinearLayout
            android:id="@+id/uploadRowsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/appDividerColor" />
    </LinearLayout>

    <ListView
        android:id="@+id/downloadListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="?attr/appDividerColor"
        android:dividerHeight="1dp" />
</LinearLayout>
