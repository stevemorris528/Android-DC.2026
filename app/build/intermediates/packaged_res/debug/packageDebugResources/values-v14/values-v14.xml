<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppBaseTheme" parent="android:Theme.Holo.Light.DarkActionBar">
        <item name="appBackgroundColor">@color/light_bg</item>
        <item name="appSurfaceColor">@color/light_surface</item>
        <item name="appHeaderBackgroundColor">@color/light_header_bg</item>
        <item name="appTextColorPrimary">@color/light_text_primary</item>
        <item name="appTextColorSecondary">@color/light_text_secondary</item>
        <item name="appDividerColor">@color/light_divider</item>
        <item name="appInputBackgroundColor">@color/light_input_bg</item>

        
        <item name="android:actionBarTabStyle">@style/RoundedActionBarTab</item>
        <item name="android:actionBarTabTextStyle">@style/RoundedActionBarTabText</item>
        <item name="android:actionBarTabBarStyle">@style/RoundedActionBarTabBar</item>

        
        <item name="android:dialogTheme">@style/RoundedDialogTheme</item>
        <item name="android:alertDialogTheme">@style/RoundedAlertDialogTheme</item>
    </style>
    <style name="AppBaseThemeDark" parent="android:Theme.Holo">
        <item name="appBackgroundColor">@color/dark_bg</item>
        <item name="appSurfaceColor">@color/dark_surface</item>
        <item name="appHeaderBackgroundColor">@color/dark_header_bg</item>
        <item name="appTextColorPrimary">@color/dark_text_primary</item>
        <item name="appTextColorSecondary">@color/dark_text_secondary</item>
        <item name="appDividerColor">@color/dark_divider</item>
        <item name="appInputBackgroundColor">@color/dark_input_bg</item>

        
        <item name="android:actionBarTabStyle">@style/RoundedActionBarTabDark</item>
        <item name="android:actionBarTabTextStyle">@style/RoundedActionBarTabTextDark</item>
        <item name="android:actionBarTabBarStyle">@style/RoundedActionBarTabBarDark</item>

        
        <item name="android:dialogTheme">@style/RoundedDialogThemeDark</item>
        <item name="android:alertDialogTheme">@style/RoundedAlertDialogThemeDark</item>
    </style>
    <style name="AppTheme.Blue">
        <item name="appColorAccent">@color/theme_blue_primary</item>
        <item name="appColorAccentPressed">@color/theme_blue_pressed</item>
    </style>
    <style name="AppTheme.Green">
        <item name="appColorAccent">@color/theme_green_primary</item>
        <item name="appColorAccentPressed">@color/theme_green_pressed</item>
    </style>
    <style name="AppTheme.Orange">
        <item name="appColorAccent">@color/theme_orange_primary</item>
        <item name="appColorAccentPressed">@color/theme_orange_pressed</item>
    </style>
    <style name="AppTheme.Purple">
        <item name="appColorAccent">@color/theme_purple_primary</item>
        <item name="appColorAccentPressed">@color/theme_purple_pressed</item>
    </style>
    <style name="AppThemeDark.Blue">
        <item name="appColorAccent">@color/theme_blue_accent</item>
        <item name="appColorAccentPressed">@color/theme_blue_primary_dark</item>
    </style>
    <style name="AppThemeDark.Green">
        <item name="appColorAccent">@color/theme_green_accent</item>
        <item name="appColorAccentPressed">@color/theme_green_primary_dark</item>
    </style>
    <style name="AppThemeDark.Orange">
        <item name="appColorAccent">@color/theme_orange_accent</item>
        <item name="appColorAccentPressed">@color/theme_orange_primary_dark</item>
    </style>
    <style name="AppThemeDark.Purple">
        <item name="appColorAccent">@color/theme_purple_accent</item>
        <item name="appColorAccentPressed">@color/theme_purple_primary_dark</item>
    </style>
    <style name="RoundedActionBarTab" parent="android:Widget.Holo.Light.ActionBar.TabView">
        <item name="android:background">@drawable/tab_indicator_rounded</item>
        <item name="android:paddingLeft">@dimen/tab_padding_horizontal</item>
        <item name="android:paddingRight">@dimen/tab_padding_horizontal</item>
    </style>
    <style name="RoundedActionBarTabBar" parent="android:Widget.Holo.Light.ActionBar.TabBar">
        <item name="android:background">@color/brand_tab_bar_bg</item>
    </style>
    <style name="RoundedActionBarTabBarDark" parent="android:Widget.Holo.ActionBar.TabBar">
        <item name="android:background">@color/dark_tab_bar_bg</item>
    </style>
    <style name="RoundedActionBarTabDark" parent="android:Widget.Holo.ActionBar.TabView">
        <item name="android:background">@drawable/tab_indicator_rounded_dark</item>
        <item name="android:paddingLeft">@dimen/tab_padding_horizontal</item>
        <item name="android:paddingRight">@dimen/tab_padding_horizontal</item>
    </style>
    <style name="RoundedActionBarTabText" parent="android:Widget.Holo.Light.ActionBar.TabText">
        <item name="android:textColor">@color/tab_text_color_selector</item>
        <item name="android:textSize">@dimen/tab_text_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="RoundedActionBarTabTextDark" parent="android:Widget.Holo.ActionBar.TabText">
        <item name="android:textColor">@color/tab_text_color_selector_dark</item>
        <item name="android:textSize">@dimen/tab_text_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="RoundedAlertDialogTheme" parent="android:Theme.Holo.Light.Dialog">
        <item name="android:windowBackground">@drawable/dialog_rounded_bg</item>
    </style>
    <style name="RoundedAlertDialogThemeDark" parent="android:Theme.Holo.Dialog">
        <item name="android:windowBackground">@drawable/dialog_rounded_bg_dark</item>
    </style>
    <style name="RoundedDialogTheme" parent="android:Theme.Holo.Light.Dialog">
        <item name="android:windowBackground">@drawable/dialog_rounded_bg</item>
    </style>
    <style name="RoundedDialogThemeDark" parent="android:Theme.Holo.Dialog">
        <item name="android:windowBackground">@drawable/dialog_rounded_bg_dark</item>
    </style>
</resources>