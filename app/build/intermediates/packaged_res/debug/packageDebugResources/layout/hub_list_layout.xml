<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/appSurfaceColor">

    <CheckBox
        android:id="@+id/checkbox_auto_reconnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="@string/auto_reconnect_hubs"
        android:textColor="?attr/appTextColorPrimary"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/appDividerColor" />

    <ListView
        android:id="@+id/hub_list_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="?attr/appDividerColor"
        android:dividerHeight="1dp" />
</LinearLayout>
